# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every variable the backend reads is listed here. Values are placeholders only.
#
# Generate a SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# config.settings.dev | config.settings.prod | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required in prod; the prod settings module refuses to import without it.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# ---------------------------------------------------------------------------
# Database
# DATABASE_URL, when set, overrides the POSTGRES_* values below.
# ---------------------------------------------------------------------------
POSTGRES_DB=campus_rental
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:change-me@db:5432/campus_rental
# Seconds a database connection is reused. 0 disables persistent connections.
CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Redis — cache, readiness probe, and the job queue
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# CORS / CSRF
# Explicit origin lists. There is no "allow all" switch anywhere in this
# project; widen these instead. Both are required in prod.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------------
# JWT lifetimes
# ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# Transport security (prod only; ignored by dev and test settings)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Set True only when a TRUSTED proxy terminates TLS and sets
# X-Forwarded-Proto. An untrusted proxy makes this a downgrade vector.
USE_X_FORWARDED_PROTO=True

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=DEBUG
# True emits one JSON object per line, for a log shipper. Defaults True in prod.
LOG_JSON=False

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.test

# ---------------------------------------------------------------------------
# Frontend (Vite inlines this at build time)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
